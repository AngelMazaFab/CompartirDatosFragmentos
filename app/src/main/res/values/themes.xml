<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.CompartirDatosFragmentos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
    </style>

    <style name="Theme.CompartirDatosFragmentos" parent="Base.Theme.CompartirDatosFragmentos" />

    <!--
        IMPORTANTE: todos los estilos con notación de punto (TextStyle.X, Widget.App.Button.X)
        deben declarar parent="" explícitamente para evitar que AAPT busque un padre inexistente.
    -->

    <!-- Breadcrumb / Step indicator -->
    <style name="TextStyle.Breadcrumb" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.StepCounter" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorStepText</item>
    </style>

    <!-- Títulos de sección -->
    <style name="TextStyle.SectionTitle" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.SectionSubtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <!-- Labels de campo (en mayúsculas pequeñas) -->
    <style name="TextStyle.FieldLabel" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/colorTextLabel</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Valores de datos en tarjeta -->
    <style name="TextStyle.DataValue" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.DataValueSmall" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Subsección (con punto) -->
    <style name="TextStyle.SubsectionHeader" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botón CTA principal -->
    <style name="Widget.App.Button.Primary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Botón secundario -->
    <style name="Widget.App.Button.Secondary" parent="">
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/colorButtonSecText</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>