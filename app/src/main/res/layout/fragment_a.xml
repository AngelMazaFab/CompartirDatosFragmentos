<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    tools:context=".FragmentA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══ CABECERA azul marino ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Fila breadcrumb + contador de paso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_breadcrumb"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● FRAGMENT A  •  REGISTRO &amp; DESTINO"
                    android:textColor="@color/colorAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paso 1 de 2"
                    android:textColor="#AAAACC"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Título de la sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos del Viajero"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completa tus datos personales para armar el voucher de viaje"
                android:textColor="#AAAACC"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ══ CUERPO del formulario ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- NOMBRE COMPLETO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOMBRE COMPLETO"
                style="@style/TextStyle.FieldLabel"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="Nombre y Apellidos"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextLabel"
                android:layout_marginBottom="14dp" />

            <!-- EDAD y ESTATURA en fila -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EDAD"
                        style="@style/TextStyle.FieldLabel"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEdad"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="16dp"
                        android:hint="0"
                        android:inputType="number"
                        android:textSize="15sp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextLabel" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ESTATURA (M)"
                        style="@style/TextStyle.FieldLabel"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEstatura"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="16dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textSize="15sp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextLabel" />

                </LinearLayout>

            </LinearLayout>

            <!-- CORREO ELECTRÓNICO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CORREO ELECTRÓNICO"
                style="@style/TextStyle.FieldLabel"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="correo@correo.com"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextLabel"
                android:layout_marginBottom="14dp" />

            <!-- SUSCRIBIRSE Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cbSuscrito"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Suscribirse a novedades y ofertas"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:buttonTint="@color/colorAccent" />

            </LinearLayout>

            <!-- ══ SPINNER DE PAÍSES ══ -->
            <!-- Label + badge "Activo" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELECCIONE UN PAÍS PARA VIAJAR"
                        style="@style/TextStyle.FieldLabel" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Destino internacional de vuelo directo"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_active"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Activo"
                    android:textColor="@color/colorBadgeActive"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerPais"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="20dp" />

            <!-- ══ BOTÓN CTA ══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Ir a Fragment B  →"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/colorAccent"
                app:cornerRadius="28dp"
                android:layout_marginBottom="24dp" />

            <!-- ══ INFORMACIÓN DEL VIAJE (recibida de Fragment B) ══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="● Información del Viaje"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvRespuesta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextSecondary"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══ AUTO SELECCIONADO en Fragment B ══ -->
            <TextView
                android:id="@+id/tvAutoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUTO SELECCIONADO EN FRAGMENT B:"
                style="@style/TextStyle.FieldLabel"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivAutoSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>